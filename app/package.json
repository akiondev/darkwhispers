{
  "name": "darkwhispers-app",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "format": "prettier --write server shared web tests *.json vite.config.ts",
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/main.js",
    "worker": "node dist/server/server/worker.js",
    "test": "node --import tsx --test tests/analysis.test.ts tests/api.test.ts tests/wcl.test.ts tests/mechanics.test.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "10.3.0",
    "echarts": "6.1.0",
    "fastify": "5.12.7",
    "lucide-react": "0.577.0",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
