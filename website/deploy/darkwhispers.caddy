darkwhispers.akion.se {
	root * /srv/darkwhispers-site/current
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; upgrade-insecure-requests"
		Strict-Transport-Security "max-age=31536000"
		Cache-Control "no-cache"
	}
	@addon path /downloads/*.zip
	header @addon Content-Disposition "attachment"
	@launcher path /launcher/downloads/*
	header @launcher Content-Disposition "attachment"
	file_server {
		precompressed gzip
	}
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
